# Variáveis de Ambiente do Satisfactory+ (NÃO coloque senhas reais neste arquivo)
# Copie para .env para uso local ou configure no painel da Vercel.

# Conta Administradora / CEO (criada automaticamente na inicialização; nunca enviada ao front-end)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Usernames extras com permissão de CEO/Admin (opcional, separados por vírgula)
EXTRA_ADMIN_USERNAMES=

# Segredo criptográfico para assinatura de sessões (use 64 caracteres hex aleatórios)
SESSION_SECRET=

# Segredo para autorizar a rotina agendada diária de limpeza (/api/cron/cleanup)
CRON_SECRET=

# Origens CORS extras permitidas (opcional, separadas por vírgula; ex.: https://meu-dominio.com)
ALLOWED_ORIGINS=

# Token automático do Vercel Blob (injetado automaticamente ao conectar um Blob Store na Vercel)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis / Vercel KV (opcional; quando configurado, acelera leituras e compartilha rate-limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Notificação de novos Reports para o CEO (opcional)
RESEND_API_KEY=
CEO_NOTIFY_EMAIL=
RESEND_FROM_EMAIL=
CEO_NOTIFY_WEBHOOK_URL=
